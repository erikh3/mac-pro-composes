# Optional outbound scraping proxy for Firecrawl.
# Non-secret settings only. Provide the password via the PROXY_PASSWORD env var,
# sourced from your shell (never committed), e.g.
#   PROXY_PASSWORD=... docker compose --profile firecrawl up -d
# This file is optional (env_file required:false).
#
# Applies to both the api and the playwright renderer.
# PROXY_SERVER=http://proxy.example.com:8080
# PROXY_USERNAME=user
