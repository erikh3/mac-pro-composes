# Optional outbound scraping proxy for Firecrawl (non-secret settings only).
# The proxy password is a docker secret: put it in
#   ${FIRECRAWL_SECRETS_BASE_DIR}/proxy-password
# (see README). This file is optional (env_file required:false).
#
# Applies to both the api and the playwright renderer.
# PROXY_SERVER=http://proxy.example.com:8080
# PROXY_USERNAME=user
