# Optional LLM provider for Firecrawl /extract + structured formats.
# Non-secret settings only. The API key is a docker secret: put it in
#   ${FIRECRAWL_SECRETS_BASE_DIR}/openai-api-key
# (see README). This file is optional (env_file required:false).
#
# Core scrape / crawl / map / search do NOT need any of this.
#
# --- OpenAI-compatible cloud endpoint ---
# OPENAI_BASE_URL=https://api.openai.com/v1
# MODEL_NAME=gpt-4o-mini
# MODEL_EMBEDDING_NAME=text-embedding-3-small
#
# --- Local Ollama on the host (api reaches it via host.docker.internal) ---
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# MODEL_NAME=llama3.1
