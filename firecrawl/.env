# Firecrawl self-host stack (profile: firecrawl)
# https://github.com/firecrawl/firecrawl

# --- Images ---------------------------------------------------------------
# Only the api image publishes semver tags; the sidecars publish only `latest`.
FIRECRAWL_IMAGE=ghcr.io/firecrawl/firecrawl
FIRECRAWL_TAG=2.11.202

PLAYWRIGHT_IMAGE=ghcr.io/firecrawl/playwright-service
PLAYWRIGHT_TAG=latest

NUQ_POSTGRES_IMAGE=ghcr.io/firecrawl/nuq-postgres
NUQ_POSTGRES_TAG=latest

REDIS_IMAGE=redis
REDIS_TAG=alpine

RABBITMQ_IMAGE=rabbitmq
RABBITMQ_TAG=3-management

# --- API exposure ---------------------------------------------------------
HOST_PORT=3002       # host bind (127.0.0.1 only), used by AI agents
INTERNAL_PORT=3002   # api port inside the container

# --- Auth -----------------------------------------------------------------
# Trusted-localhost run: no API key. Real auth needs Supabase + DB schema.
USE_DB_AUTHENTICATION=false

# --- PostgreSQL (NuQ queue) ----------------------------------------------
# Internal-only (private net, no host port). Keep POSTGRES_DB=postgres: the
# bundled pg_cron config targets that database. CHANGE the password.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-to-32-plus-random-characters
POSTGRES_DB=postgres

# --- Concurrency / capacity ----------------------------------------------
NUM_WORKERS_PER_QUEUE=8
CRAWL_CONCURRENT_REQUESTS=10
MAX_CONCURRENT_JOBS=5
BROWSER_POOL_SIZE=5

# --- Resource limits ------------------------------------------------------
# Total ~= API_MEM + PLAYWRIGHT_MEM; ensure the Docker VM has enough RAM.
FIRECRAWL_API_CPUS=4.0
FIRECRAWL_API_MEM=8G
PLAYWRIGHT_CPUS=2.0
PLAYWRIGHT_MEM=4G

# --- Logging / misc -------------------------------------------------------
LOGGING_LEVEL=INFO
RESTART=unless-stopped

# --- Optional: LLM provider for /extract + structured formats -------------
# Core scrape/crawl/map/search do NOT need these. Fill in to enable extraction.
# OpenAI-compatible cloud:
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# MODEL_NAME=gpt-4o-mini
# MODEL_EMBEDDING_NAME=text-embedding-3-small
# Local Ollama on the host (api reaches it via host.docker.internal):
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- Optional: outbound scraping proxy ------------------------------------
# PROXY_SERVER=
# PROXY_USERNAME=
# PROXY_PASSWORD=
